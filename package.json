{
  "name": "echuu-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Echuu brand website — AI VTuber platform for Original Characters",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "node scripts/release-gate.mjs && tsc -b && vite build",
